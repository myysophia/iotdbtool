# IoTDB 导出脚本路径
IOTDB_EXPORT_BIN=/home/ec2-user/apache-iotdb-1.1.2-all-bin/tools/export-csv.sh

# IoTDB 连接信息
IOTDB_HOST=
IOTDB_PORT=6667
IOTDB_USERNAME=
IOTDB_PASSWORD=

# 设备列表，多个使用逗号分隔
IOTDB_DEVICES=sn08,sn24



# 临时文件与产物输出目录
IOTDB_WORKDIR=./iotdbtmp
IOTDB_OUTPUT_DIR=./iotdb/artifacts

# OSS 上传配置
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=iotdbeu
# 公网访问域名，可直接按以下拼接
OSS_BASE_URL=
OSSUTIL_BIN=ossutil64

# 企业微信机器人 webhook 地址
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=

# 其他设置
LOG_LEVEL=INFO
